{
  "name": "MT4008 (R)",
  "image": "ghcr.io/rocker-org/devcontainer/r-ver:4.5",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": { "version": "1.8.25" }
  },
  "postCreateCommand": "Rscript -e 'renv::restore(prompt = FALSE)'",
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "quarto.quarto",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
