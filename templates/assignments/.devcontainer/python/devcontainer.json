{
  "name": "MT4008 (Python)",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": { "version": "1.8.25" }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && ~/.local/bin/uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "quarto.quarto",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
